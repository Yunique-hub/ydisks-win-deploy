# ============ 上游源码（由 bootstrap 克隆，不入库）============
app/

# ============ 运行时与工具链（由 bootstrap 生成，不入库）============
runtime/

# ============ 业务数据（★ 含加密密钥，绝对不能入库）============
data/

# ============ 日志 ============
logs/
*.log

# ============ 下载缓存 ============
downloads/

# ============ PowerShell ============
# 脚本自身的静态检查不产生文件；这里挡掉常见临时产物
*.tmp.ps1
_deploy_tmp/

# ============ 编辑器 / 系统 ============
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ============ 敏感信息 ============
.env
.env.*
!.env.example
*.pem
*.key
*.p12
data.key
初始管理员凭据.txt

# ============ 构建产物（不入库，走 Releases）============
*.exe
*.msi
*.zip
*.7z

# ============ Node（若在根目录误跑）============
node_modules/
package-lock.json

# ============ 发布准备 / 备份（工作区内部产物）============
_publish/
_publish_v2/
_backup/
